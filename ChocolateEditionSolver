-- Main Solver Loop
local lastSolveTime, SOLVE_COOLDOWN = 0, 0.15
task.spawn(function()
    while true do
        task.wait(0.1)
        if cachedB and not cachedB.Parent then
            cachedB = nil; state.lastPartCount = -1; state.grid.w = 0; state.grid.h = 0; state.cells.grid = {}; state.cells.numbered = {}; state.cells.toFlag = {}; state.cells.toClear = {}; autoFlaggedSet = {}; clearBarriers(); hlActive = {}; changeQueue = {}; queueSet = {}; solverDirty = false; lastSolveTime = 0
            for _, conn in pairs(signalConns) do conn:Disconnect() end signalConns = {}
            local f = workspace:FindFirstChild(S_MoonMineHL) if f then f:Destroy() end hlFolder = nil
        end

        if solverEnabled or antiMinesEnabled or autoWinEnabled or touchTilesEnabled or autoFlagToggle then
            local folder = scanB()
            if folder then
                local pc = #folder:GetChildren()
                if state.grid.w == 0 or pc ~= state.lastPartCount then
                    state.lastPartCount = pc
                    pcall(rebuildG, folder)
                    task.wait()
                end

                local now = tick()
                if state.grid.w > 0 then
                    if solverDirty and (now - lastSolveTime) >= SOLVE_COOLDOWN then
                        solverDirty = false; lastSolveTime = now
                        pcall(processQueue)
                        task.wait()
                        pcall(updateL)
                    end
                    pcall(updateH)

                    if antiMinesEnabled then task.wait(); pcall(updateBarriers) end
                end
            end
        end
    end
end)

